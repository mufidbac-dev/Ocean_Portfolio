{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "General visual and branding settings for the 3D portfolio and website.",
      "type": "object",
      "properties": {
        "siteTitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Site header and branding title"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 80,
          "description": "Owner or creator name"
        },
        "tagline": {
          "type": "string",
          "maxLength": 200,
          "description": "Short bio or tagline"
        },
        "accentColor": {
          "type": "string",
          "maxLength": 16,
          "description": "Primary accent color in hex format"
        },
        "oceanTime": {
          "type": "string",
          "enum": ["day", "golden", "night"],
          "description": "Atmosphere and sky lighting mode for the 3D ocean scene"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["siteTitle", "ownerName"]
    },
    "AboutProfile": {
      "title": "AboutProfile",
      "description": "Studio island profile, creative biography, clients list and process steps.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "maxLength": 100,
          "description": "Full creator name"
        },
        "headline": {
          "type": "string",
          "maxLength": 150,
          "description": "Professional headline or role"
        },
        "bio": {
          "type": "string",
          "maxLength": 5000,
          "description": "Detailed biographical markdown prose"
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Profile photo URL"
        },
        "cvUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Downloadable curriculum vitae PDF link"
        },
        "clients": {
          "type": "array",
          "description": "Client list or collaborative brands"
        },
        "processSteps": {
          "type": "array",
          "description": "Array of creative process steps"
        },
        "socialLinks": {
          "type": "object",
          "description": "Social media links"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["fullName", "headline", "bio"]
    },
    "Project": {
      "title": "Project",
      "description": "Creative portfolio project showcased on Gallery Island.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Project title"
        },
        "slug": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9_-]+$",
          "description": "URL friendly slug"
        },
        "category": {
          "type": "string",
          "maxLength": 60,
          "description": "Project category (Campaign, Interiors, Still Life, Travel)"
        },
        "year": {
          "type": "number",
          "description": "Year of execution"
        },
        "client": {
          "type": "string",
          "maxLength": 100,
          "description": "Client name"
        },
        "summary": {
          "type": "string",
          "maxLength": 500,
          "description": "Short summary"
        },
        "description": {
          "type": "string",
          "maxLength": 10000,
          "description": "Detailed project description"
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Cover hero image"
        },
        "galleryUrls": {
          "type": "array",
          "description": "Additional project media gallery URLs"
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Publication status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "category", "isPublished"]
    },
    "Article": {
      "title": "Article",
      "description": "Journal essay or technical note on Library Island.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Article title"
        },
        "slug": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[a-z0-9_-]+$"
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "maxLength": 20000,
          "description": "Rich text journal body"
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "tags": {
          "type": "array"
        },
        "readTimeMinutes": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "content", "isPublished"]
    },
    "Message": {
      "title": "Message",
      "description": "Visitor contact message dispatched from Signal Island.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Sender name"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Sender email"
        },
        "message": {
          "type": "string",
          "maxLength": 3000,
          "description": "Inquiry text"
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether read by admin"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "email", "message"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator account metadata.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/settings/general": {
      "schema": "SiteSettings",
      "description": "Singleton configuration for website appearance and 3D environment."
    },
    "/about/profile": {
      "schema": "AboutProfile",
      "description": "Singleton document for studio profile, biography, clients and process."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of portfolio projects."
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of journal articles."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of incoming contact inquiries."
    },
    "/admins/{adminUid}": {
      "schema": "AdminUser",
      "description": "Authorized admin users."
    }
  }
}
