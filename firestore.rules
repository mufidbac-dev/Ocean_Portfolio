rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mufidbac@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 3000;
    }

    // Health check test connection
    match /test/{docId} {
      allow read: if true;
    }

    // Settings collection (appearance, site title, ocean daytime preset)
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // About profile document
    match /about/{docId} {
      allow read: if isValidId(docId);
      allow create, update, delete: if isAdmin() && isValidId(docId);
    }

    // Portfolio projects
    match /projects/{projectId} {
      allow read: if isValidId(projectId);
      allow create, update, delete: if isAdmin() && isValidId(projectId);
    }

    // Journal articles
    match /articles/{articleId} {
      allow read: if isValidId(articleId);
      allow create, update, delete: if isAdmin() && isValidId(articleId);
    }

    // Messages / inquiries from Signal Island contact form
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(request.resource.data);
      allow read, update, delete: if isAdmin() && isValidId(messageId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
